# marimo + Spark 4.1 + PyIceberg image for the native Iceberg (Iceberg REST
# catalog) notebooks in marimo-playground/notebooks/iceberg/.
#
# Spark 4.1 rather than the 4.2 used by the main Dockerfile: Apache Iceberg
# publishes iceberg-spark-runtime only for Spark 4.0 / 4.1, and UC 0.7's Iceberg
# REST catalog is tested end-to-end against Spark 4.0/4.1 + Iceberg 1.11.
FROM apache/spark:4.1.3-java21-python3

ARG PYSPARK_VERSION=4.1.3
ARG PYICEBERG_VERSION=0.12.0
ARG MARIMO_VERSION=0.23.16

USER root

# Optional pip index URL override, e.g. for building behind a corporate PyPI
# proxy: --build-arg PYPI_PROXY_URL=https://pypi-proxy.your-company.com/simple/
ARG PYPI_PROXY_URL=""
ENV PYPI_PROXY_URL=${PYPI_PROXY_URL}
ENV PIP_INDEX_URL=${PYPI_PROXY_URL:-https://pypi.org/simple/}

RUN pip install --no-cache-dir \
        "marimo[recommended]>=${MARIMO_VERSION}" \
        "numpy>=2.2.6" \
        "pyspark==${PYSPARK_VERSION}" \
        "pyiceberg[pyarrow,pandas,pyiceberg-core]==${PYICEBERG_VERSION}"

WORKDIR /opt/workspace

COPY marimo-playground/notebooks/ ./marimo-playground/notebooks/

EXPOSE 2719

ENTRYPOINT ["marimo", "edit", "--host", "0.0.0.0", "--port", "2719", "marimo-playground/notebooks/iceberg/"]
