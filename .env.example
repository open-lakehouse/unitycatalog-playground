# Copy this file to .env and fill in values as needed:
#
#   cp .env.example .env      (or run: just init)
#
# docker compose automatically loads .env from the project root, so any values
# set here are picked up when building the image and starting the containers.

# --- PyPI proxy (build time) -------------------------------------------------
# Optional PyPI index/proxy URL used while BUILDING the marimo-spark image.
# REQUIRED when building internally at Databricks, where the public PyPI is not
# reachable and packages must be pulled through the corporate mirror.
# Leave blank to use the default public PyPI (https://pypi.org/simple).
#
# Example:
#   PYPI_PROXY_URL=https://pypi-proxy.{your-company}.com/simple
PYPI_PROXY_URL=

# --- Local delta-spark override (build time, pre-release testing) ------------
# Filename of a wheel staged under spark/delta-override/ (stage it with
# `just stage-delta <path-to-wheel>`). When set, the image installs THIS wheel
# instead of delta-spark==<DELTA_SPARK_VERSION> from PyPI — useful for testing a
# locally-built, not-yet-published delta-spark. Rebuild after changing it
# (`just rebuild`). Leave blank for normal PyPI builds.
#
# Example:
#   DELTA_SPARK_WHEEL=delta_spark-4.4.0-py3-none-any.whl
DELTA_SPARK_WHEEL=

# --- Maven proxy (run time) --------------------------------------------------
# Optional Maven proxy passed into the marimo-spark container at run time. Spark
# uses this to resolve jars declared in `spark.jars.packages` when Maven Central
# is not directly reachable (e.g. behind the Databricks corporate firewall).
# Leave blank to use Maven Central.
#
# Example:
#   MAVEN_PROXY_URL=https://maven-proxy.{your-company}.com/maven2
MAVEN_PROXY_URL=

# --- Local Ivy repository (run time) -----------------------------------------
# Host directory bind-mounted into the marimo-spark container at /opt/ivy2 so
# Spark can resolve jars you published locally with `bin/sbt publishLocal`
# (e.g. the unitycatalog-spark SNAPSHOT). These live under ~/.ivy2/local on the
# host. The container sets SPARK_JARS_IVY=/opt/ivy2 and the notebook applies it
# as `spark.jars.ivy`, so Spark searches `${SPARK_JARS_IVY}/local`.
# Leave blank to use the default ~/.ivy2 in your home directory.
#
# Example:
#   HOST_IVY_DIR=/Users/you/.ivy2
HOST_IVY_DIR=

# --- Unity Catalog server (run time) -----------------------------------------
# The Unity Catalog server the notebooks connect to. UC_SERVER_URL may be either
# a bare host (combined with UC_SERVER_PORT to form http://<host>:<port>) or a
# full URL including the scheme, which is used verbatim. Use a full URL to point
# at a remote, auth-enabled UC server.
# Leave blank to use the in-network `unitycatalog` host on port 8080.
#
# Examples:
#   UC_SERVER_URL=unitycatalog                       # bare host + UC_SERVER_PORT
#   UC_SERVER_URL=https://prod.uc.company.com  # full URL, used as-is
UC_SERVER_URL=unitycatalog
UC_SERVER_PORT=8080

# Bearer token used with an auth-enabled Unity Catalog server. Leave blank for
# the local docker/quickstart server, which runs without auth.
UC_TOKEN=

# --- Local UC Postgres (run time, uc=local only) -----------------------------
# Backend for the bundled Unity Catalog server (Compose profile `local-uc`).
# Defaults match Unity Catalog's etc/db/postgres-example.yml and
# etc/conf/hibernate.properties in this repo. If you change these, update
# hibernate.properties to match (UC reads the JDBC URL/user/password from that
# file, not from these env vars).
#
# Data is stored in the named Docker volume `uc_postgres_data` and survives
# `just down` / restarts. Wipe it with `just clean` or `just down-volumes`.
POSTGRES_DB=ucdb
POSTGRES_USER=uc_default_user
POSTGRES_PASSWORD=uc_default_password
POSTGRES_PORT=5432

# --- RustFS object store (run time, uc=local only) ---------------------------
# The bundled local Unity Catalog (uc=local) stores MANAGED TABLE DATA in RustFS,
# an S3-compatible object store, instead of a local file path — so the local
# stack behaves like a cloud UC on real object storage. On startup the
# `rustfs-init` service creates the bucket and mints a short-lived STS credential
# that UC vends to Spark. Managed data lives in the `rustfs_data` volume (wiped by
# `just clean` / `just down-volumes`).
#
# Local-only dev credentials. The RustFS web console is at http://localhost:9001
# (S3 API on :9000). Change these before exposing RustFS anywhere.
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# Bucket used as the UC managed-tables storage root (s3://<bucket>).
UC_STORAGE_BUCKET=uc-warehouse

# Region label sent to S3/STS. RustFS is region-agnostic, but Hadoop's S3A wants
# one set; keep it in sync with what the notebooks use.
S3_REGION=us-east-1

# Lifetime (seconds) of the STS credential rustfs-init mints for UC to vend.
# RustFS clamps this to <= 43200 (12h). After it expires, re-mint + reload with
# `just uc=local rotate-creds`.
STS_DURATION_SECONDS=43200

# Host ports published for RustFS (S3 API / web console).
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# S3 endpoint the notebooks point Spark's S3A client at. Leave BLANK here:
# `just uc=local` injects http://rustfs:9000 automatically, while `just up`
# (remote UC on real S3) leaves it empty. Only set it by hand if you run the
# notebooks against a custom S3 endpoint outside the just recipes.
S3_ENDPOINT_URL=
